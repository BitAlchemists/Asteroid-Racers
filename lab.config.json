{
  "name": "asteroid-racers",
  "binding": [
    "packages/shared/src/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/node/src/lab-train.ts",
    "scripts/lab-train.mjs",
    "!**/*.test.ts"
  ],
  "metrics": {
    "score": { "direction": "min", "label": "Best score (lower is better)" },
    "mean": { "direction": "min", "label": "Mean score of the generation" },
    "worst": { "direction": "min", "label": "Worst score of the generation" },
    "success": { "direction": "max", "label": "Share of training targets the winner reached" },
    "heldOut": { "direction": "min", "label": "Winner's score on held-out scenarios" },
    "heldOutSuccess": { "direction": "max", "label": "Share of held-out targets the winner reached" }
  },
  "leaderboard": { "metrics": ["score"] },
  "methods": {
    "train": {
      "command": ["node", "scripts/lab-train.mjs"],
      "config": {
        "sample": 100,
        "frames": 600,
        "mutationRate": 0.1,
        "mutationStrength": 1,
        "generations": 200,
        "brain": {
          "inputs": ["targetAngle", "targetDistance", "velocityAngle", "speed"],
          "hidden": [10, 8, 6, 4],
          "outputs": "thrustTurn"
        },
        "arenas": [{ "name": "legacy", "params": {} }],
        "scoring": { "distance": 1, "success": 0, "time": 0, "crashes": 0 },
        "collisions": "none",
        "crashMode": "end",
        "heldOut": 0
      },
      "seeded": true,
      "defaultSeed": 2026,
      "resumable": true
    }
  }
}
