{
  "name": "asteroid-racers",
  "private": true,
  "type": "module",
  "description": "Multiplayer space racing in the browser — Node.js/TypeScript port",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ar/web",
    "build": "npm run build -w @ar/web",
    "server": "npm run start -w @ar/node",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "proto": "buf generate",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "train": "npm run train -w @ar/node --",
    "bot": "npm run bot -w @ar/node --"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
